<style>
:root{
  --bg:#080C0A;
  --panel:#101612;
  --panel2:#151D17;
  --line:#243128;
  --green:#39FF88;
  --green2:#20A95B;
  --text:#EEF4F0;
  --muted:#91A097;
  --red:#FF4D5D;
  --yellow:#FFBE45;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  padding:0;
  width:100%;
  min-height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
}

body{
  background-image:
    linear-gradient(rgba(36,49,40,.35) 1px,transparent 1px),
    linear-gradient(90deg,rgba(36,49,40,.35) 1px,transparent 1px);
  background-size:28px 28px;
}

button,input,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

#app{
  width:100%;
  max-width:520px;
  min-height:100vh;
  margin:auto;
  background:rgba(8,12,10,.96);
  position:relative;
}

/* TOP BAR */

.topbar{
  position:sticky;
  top:0;
  z-index:50;
  padding:15px 16px;
  background:rgba(8,12,10,.94);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-weight:900;
  font-size:18px;
  letter-spacing:1px;
}

.logo span{
  color:var(--green);
}

.status{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:10px;
  color:var(--muted);
  text-transform:uppercase;
}

.dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--red);
}

.dot.on{
  background:var(--green);
  box-shadow:0 0 8px var(--green);
}

/* CONTENT */

.content{
  padding:20px 16px 100px;
}

.view{
  display:none;
}

.view.active{
  display:block;
  animation:appear .2s ease;
}

@keyframes appear{
  from{
    opacity:0;
    transform:translateY(5px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.eyebrow{
  color:var(--green);
  font-size:10px;
  font-weight:800;
  letter-spacing:2px;
  text-transform:uppercase;
  margin:0 0 5px;
}

h1{
  margin:0 0 7px;
  font-size:25px;
  letter-spacing:-.5px;
}

.subtitle{
  color:var(--muted);
  font-size:13px;
  line-height:1.55;
  margin:0 0 18px;
}

/* CARDS */

.card{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:15px;
  margin-bottom:13px;
}

.card-title{
  font-size:11px;
  font-weight:800;
  letter-spacing:1px;
  text-transform:uppercase;
  color:var(--muted);
  margin:0 0 12px;
}

.card-title span{
  color:var(--green);
}

/* INPUTS */

label{
  display:block;
  color:var(--muted);
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.7px;
  margin-bottom:6px;
}

input,
textarea{
  width:100%;
  background:#080C0A;
  border:1px solid var(--line);
  border-radius:7px;
  color:var(--text);
  padding:11px 12px;
  outline:none;
  margin-bottom:11px;
  font-size:14px;
}

textarea{
  min-height:100px;
  resize:vertical;
  line-height:1.5;
}

input:focus,
textarea:focus{
  border-color:var(--green);
}

/* BUTTONS */

.btn{
  width:100%;
  border:0;
  border-radius:7px;
  padding:12px 14px;
  background:var(--green);
  color:#061009;
  font-size:12px;
  font-weight:900;
  letter-spacing:.7px;
  text-transform:uppercase;
}

.btn:active{
  transform:scale(.98);
}

.btn.secondary{
  background:transparent;
  border:1px solid var(--line);
  color:var(--text);
}

.btn.danger{
  background:var(--red);
  color:white;
}

.row{
  display:flex;
  gap:8px;
}

.row .btn{
  flex:1;
}

/* CHAT */

.chat{
  display:flex;
  flex-direction:column;
  gap:9px;
  min-height:250px;
  margin-bottom:12px;
}

.message{
  max-width:88%;
  padding:10px 12px;
  border-radius:9px;
  font-size:13.5px;
  line-height:1.5;
  white-space:pre-wrap;
}

.message.ai{
  background:var(--panel2);
  border:1px solid var(--line);
  align-self:flex-start;
}

.message.user{
  background:var(--green2);
  color:white;
  align-self:flex-end;
}

.chatbox{
  display:flex;
  gap:8px;
  position:sticky;
  bottom:72px;
}

.chatbox textarea{
  min-height:46px;
  height:46px;
  margin:0;
  flex:1;
}

.send{
  width:75px;
  border:0;
  border-radius:7px;
  background:var(--green);
  font-weight:900;
}

/* QUICK PROMPTS */

.quick{
  display:flex;
  gap:7px;
  overflow-x:auto;
  padding-bottom:7px;
  margin-bottom:12px;
}

.quick button{
  white-space:nowrap;
  background:var(--panel2);
  color:var(--text);
  border:1px solid var(--line);
  border-radius:20px;
  padding:8px 11px;
  font-size:11px;
}

/* TOOL GRID */

.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}

.tool{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:9px;
  padding:14px;
}

.tool-icon{
  font-size:22px;
  margin-bottom:8px;
}

.tool-name{
  font-size:13px;
  font-weight:800;
}

.tool-desc{
  color:var(--muted);
  font-size:10px;
  line-height:1.4;
  margin-top:4px;
}

/* THUMBNAIL */

